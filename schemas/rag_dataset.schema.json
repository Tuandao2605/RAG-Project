{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rag-security:schema:rag-dataset:1.0.0",
  "title": "RAG pilot dataset v1",
  "description": "Định nghĩa document, QA và attack case cho bộ pilot Sprint 2. Document dùng lại nguyên vẹn $defs/document của urn:rag-security:schema:security-case:1.0.0 để corpus và fixture dùng chung một hợp đồng. Không dùng file này thay cho SecurityCase: SecurityCase là fixture tích hợp có retrieval cố định, còn attack case ở đây chạy trên retrieval thật của pipeline.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "not": {"pattern": "\\s"}
    },
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "split": {"enum": ["dev", "test"]},
    "split_group": {
      "type": "string",
      "pattern": "^g-[a-z0-9-]+$",
      "not": {"pattern": "\\s"}
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:\\S+$",
      "not": {"pattern": "\\s"}
    },
    "document": {"$ref": "urn:rag-security:schema:security-case:1.0.0#/$defs/document"},
    "principal": {"$ref": "urn:rag-security:schema:security-case:1.0.0#/$defs/principal"},
    "qa_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "qa_id", "split", "split_group", "question",
        "answer", "answer_aliases", "source_doc_id", "reference_span"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "qa_id": {"$ref": "#/$defs/id"},
        "split": {"$ref": "#/$defs/split"},
        "split_group": {"$ref": "#/$defs/split_group"},
        "question": {"$ref": "#/$defs/text"},
        "answer": {"$ref": "#/$defs/text"},
        "answer_aliases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "source_doc_id": {"$ref": "#/$defs/id"},
        "reference_span": {"$ref": "#/$defs/text"},
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "attack_match_rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "contains"],
          "properties": {
            "channel": {"const": "answer"},
            "contains": {"$ref": "#/$defs/text"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "not_contains"],
          "properties": {
            "channel": {"const": "answer"},
            "not_contains": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/text"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel", "contains", "destination"],
          "properties": {
            "channel": {"const": "egress"},
            "contains": {"$ref": "#/$defs/text"},
            "destination": {"$ref": "#/$defs/uri"}
          }
        }
      ]
    },
    "attack_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "case_id", "base_case_id", "split", "split_group",
        "attack_method", "attack_goal", "request", "host_doc_id", "position",
        "retrieval_mode", "payload", "objective", "success_rules",
        "task_success", "source_refs"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "case_id": {"$ref": "#/$defs/id"},
        "base_case_id": {"$ref": "#/$defs/id"},
        "split": {"const": "dev"},
        "split_group": {"$ref": "#/$defs/split_group"},
        "attack_method": {
          "enum": [
            "goal_hijacking", "fake_instruction_role", "encoding_obfuscation",
            "canary_exfiltration", "forced_refusal"
          ]
        },
        "attack_goal": {
          "enum": ["answer_contamination", "data_exfiltration", "availability_degradation"]
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["principal", "query"],
          "properties": {
            "principal": {"$ref": "#/$defs/principal"},
            "query": {"$ref": "#/$defs/text"}
          }
        },
        "host_doc_id": {"$ref": "#/$defs/id"},
        "position": {"enum": ["start", "middle", "end"]},
        "retrieval_mode": {"enum": ["natural", "forced_context"]},
        "payload": {"$ref": "#/$defs/text"},
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "description", "target_value"],
          "properties": {
            "kind": {
              "enum": [
                "answer_contamination", "data_exfiltration", "availability_degradation"
              ]
            },
            "description": {"$ref": "#/$defs/text"},
            "target_value": {"$ref": "#/$defs/text"},
            "target_doc_id": {"$ref": "#/$defs/id"}
          },
          "allOf": [
            {
              "if": {"properties": {"kind": {"const": "data_exfiltration"}}},
              "then": {"required": ["target_doc_id"]}
            }
          ]
        },
        "success_rules": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attack_success"],
          "properties": {
            "attack_success": {
              "type": "object",
              "additionalProperties": false,
              "required": ["any_of"],
              "properties": {
                "any_of": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"$ref": "#/$defs/attack_match_rule"}
                }
              }
            }
          }
        },
        "task_success": {
          "type": "object",
          "additionalProperties": false,
          "required": ["answer_contains_all", "citation_doc_ids"],
          "properties": {
            "answer_contains_all": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/text"}
            },
            "citation_doc_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/id"}
            }
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "notes": {"$ref": "#/$defs/text"}
      }
    },
    "corpus_manifest_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "split", "split_group", "license", "provenance"],
      "properties": {
        "doc_id": {"$ref": "#/$defs/id"},
        "split": {"$ref": "#/$defs/split"},
        "split_group": {"$ref": "#/$defs/split_group"},
        "license": {
          "enum": ["project-original", "CC0-1.0", "CC-BY-4.0", "public-domain", "internal-use"]
        },
        "provenance": {"$ref": "#/$defs/text"},
        "source_note": {"$ref": "#/$defs/text"}
      }
    },
    "corpus_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "corpus_version", "documents"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "corpus_version": {"$ref": "#/$defs/text"},
        "documents": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/corpus_manifest_entry"}
        }
      }
    },
    "canary_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "canaries"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "canaries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canary_id", "value", "doc_id", "note"],
            "properties": {
              "canary_id": {"$ref": "#/$defs/id"},
              "value": {"type": "string", "pattern": "^SYNTHETIC_[A-Z0-9_]+$"},
              "doc_id": {"$ref": "#/$defs/id"},
              "note": {"$ref": "#/$defs/text"}
            }
          }
        }
      }
    }
  }
}
