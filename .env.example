RAG_LLM_PROVIDER=ollama
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_LLM_MODEL=qwen2.5:3b

# Đặt RAG_LLM_PROVIDER=openai_compatible để dùng OpenAI, vLLM hoặc endpoint
# tương thích OpenAI khác.
RAG_OPENAI_BASE_URL=https://api.openai.com/v1
RAG_OPENAI_API_KEY=
RAG_OPENAI_LLM_MODEL=gpt-4o-mini

# Model được sentence-transformers tải một lần và lưu vào cache local.
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_DEVICE=cpu